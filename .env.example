# ---------- SRPanel ----------
# آدرس عمومی پنل (برای ساخت لینک ساب)
SRP_PUBLIC_URL=http://localhost:3000
# دامنه (اختیاری) برای Caddy + TLS خودکار. خالی = فقط HTTP روی پورت 80
SRP_DOMAIN=
# کلید مخفی (JWT + رمزنگاری پسورد سرورها) — با openssl rand -hex 32 بساز
SRP_SECRET=change-me-please-use-openssl-rand-hex-32
# ادمین اصلی که در اولین اجرا ساخته می‌شود
SRP_OWNER_USERNAME=admin
SRP_OWNER_PASSWORD=change-me
# نام برند پیش‌فرض
SRP_BRAND_NAME=SRPanel
# فاصله سینک با سرورها (ثانیه)
SRP_SYNC_INTERVAL_SEC=60

# ---------- Database ----------
POSTGRES_USER=srpanel
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=srpanel
DATABASE_URL=postgresql://srpanel:change-me-db@db:5432/srpanel?schema=public

# ---------- Stage 2 ----------
# منطقه زمانی پنل (زمان بکاپ روزانه و تاریخ پیام‌ها)
SRP_TZ=Asia/Tehran
# مسیر ذخیره بکاپ‌ها داخل کانتینر (ولوم srp_backups)
SRP_BACKUP_DIR=/app/backups
# مسیر ذخیره رسیدهای پرداخت (ولوم srp_uploads)
SRP_UPLOAD_DIR=/app/uploads
# (اختیاری) کلید TronGrid برای تأیید خودکار USDT در حجم بالا
SRP_TRONGRID_KEY=
