{
  "name": "srpanel",
  "version": "1.2.0",
  "private": true,
  "description": "SRPanel — Next-gen multi-server VPN reseller cloud panel",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "build": "npm run db:generate && npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "start:worker": "npm run start -w apps/worker",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/db/prisma/schema.prisma --skip-generate",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/worker/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.7.3"
  },
  "engines": { "node": ">=20.9" }
}
